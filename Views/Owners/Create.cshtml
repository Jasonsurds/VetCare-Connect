@{
    Layout = "_DashboardLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Register pet owner</h3>
                <a class="vc-card-link" asp-action="Index">← Back to owners</a>
            </div>
            <div class="vc-card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label-vc">Full name *</label>
                            <input name="name" class="form-control-vc" required placeholder="e.g. Juan Dela Cruz" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-vc">Username *</label>
                            <input name="userName" class="form-control-vc" required placeholder="Used for signing in" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-vc">Password *</label>
                            <input name="password" type="password" class="form-control-vc" required minlength="6" />
                            <div class="form-hint">Minimum 6 characters. Stored as a secure hash.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-vc">Email</label>
                            <input name="email" type="email" class="form-control-vc" placeholder="owner@example.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-vc">Contact number</label>
                            <input name="contactNumber" class="form-control-vc" placeholder="0917-000-0000" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-vc">Address</label>
                            <input name="address" class="form-control-vc" placeholder="Street, City" />
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn-vc">Register owner</button>
                        <a class="btn-vc-outline" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
