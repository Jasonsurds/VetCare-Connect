@model VetCare.ViewModels.OwnerDashboardViewModel
@{
    Layout = "_DashboardLayout";
}

<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon si-teal">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="4" r="2"></circle><circle cx="18" cy="8" r="2"></circle><circle cx="6" cy="8" r="2"></circle><path d="M12 11c-3 0-5.5 2.5-5.5 5.5S9 22 12 22s5.5-2.5 5.5-5.5S15 11 12 11z"></path></svg>
        </div>
        <div><div class="stat-number">@Model.MyPets.Count</div><div class="stat-label">My Pets</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-blue">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        </div>
        <div><div class="stat-number">@Model.UpcomingAppointments.Count</div><div class="stat-label">Upcoming Appointments</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-amber">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
        </div>
        <div><div class="stat-number">@Model.PendingInvoices.Count</div><div class="stat-label">Unpaid Invoice(s)</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-green">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        </div>
        <div><div class="stat-number">@Model.LoyaltyPoints</div><div class="stat-label">Loyalty Points</div></div>
    </div>
</div>

<div class="vc-card mb-4" style="background: linear-gradient(120deg, #0b5e52 0%, #20a390 100%); border: none;">
    <div class="vc-card-body d-flex align-items-center justify-content-between flex-wrap gap-3" style="color:#fff;">
        <div>
            <h3 class="vc-card-title" style="color:#fff;">We love pets as much as you do. 🐾</h3>
            <p style="margin:4px 0 0; opacity:.9; font-size:.9rem;">Book your pet's next visit in less than a minute.</p>
        </div>
        <a class="btn-vc" style="background:#fff; color:#0b5e52 !important;" asp-controller="Appointments" asp-action="Create">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            Book an appointment
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">My pets</h3>
                <a class="vc-card-link" asp-controller="Pets" asp-action="Index">Manage pets →</a>
            </div>
            <div class="vc-card-body">
                @if (Model.MyPets.Any())
                {
                    <div class="row g-3">
                        @foreach (var pet in Model.MyPets)
                        {
                            <div class="col-sm-6">
                                <a asp-controller="Pets" asp-action="Details" asp-route-id="@pet.PetID" class="d-block text-decoration-none">
                                    <div class="stat-card">
                                        <div class="stat-icon @(pet.Species == "Dog" ? "si-amber" : "si-purple")">
                                            @if (pet.Species == "Dog")
                                            {
                                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="6" rx="8" ry="4.5"></ellipse><path d="M4 6c0 4 2 10 8 10s8-6 8-10"></path><circle cx="9" cy="13" r="1"></circle><circle cx="15" cy="13" r="1"></circle><path d="M10.5 17.5L12 19l1.5-1.5"></path></svg>
                                            }
                                            else
                                            {
                                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="13" r="5"></circle><path d="M8 9L6 3l4 3M16 9l2-6-4 3"></path><circle cx="10" cy="12.5" r=".8"></circle><circle cx="14" cy="12.5" r=".8"></circle><path d="M12 14.5l-.8.8h1.6z"></path></svg>
                                            }
                                        </div>
                                        <div>
                                            <div class="stat-number" style="font-size:1.1rem;">@pet.PetName</div>
                                            <div class="stat-label">@pet.Species · @pet.Breed · @pet.Age yr(s)</div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <p>No pets registered yet.</p>
                        <a class="btn-vc mt-2" asp-controller="Pets" asp-action="Create">Add my first pet</a>
                    </div>
                }
            </div>
        </div>

        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Upcoming appointments</h3>
                <a class="vc-card-link" asp-controller="Appointments" asp-action="Index">View all →</a>
            </div>
            <div class="vc-card-body p-0 table-scroll">
                @if (Model.UpcomingAppointments.Any())
                {
                    <table class="vc-table">
                        <thead><tr><th>Date</th><th>Pet</th><th>Vet</th><th>Service</th><th>Status</th></tr></thead>
                        <tbody>
                        @foreach (var a in Model.UpcomingAppointments)
                        {
                            <tr>
                                <td class="cell-strong">@a.AppointmentDate.ToString("MMM dd, h:mm tt")</td>
                                <td>@a.Pet?.PetName</td>
                                <td>@a.Vet?.Name</td>
                                <td>@a.ServiceType</td>
                                <td><partial name="_StatusBadge" model="a.Status" /></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state"><p>No upcoming appointments — book one above!</p></div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Unpaid invoices</h3>
                <a class="vc-card-link" asp-controller="Billing" asp-action="Index">All invoices →</a>
            </div>
            <div class="vc-card-body p-0 table-scroll">
                @if (Model.PendingInvoices.Any())
                {
                    <table class="vc-table">
                        <thead><tr><th>Invoice</th><th>Amount</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var b in Model.PendingInvoices)
                        {
                            <tr>
                                <td>
                                    <div class="cell-strong">#INV-@b.InvoiceID.ToString("D4")</div>
                                    <div class="cell-muted">@b.Appointment?.Pet?.PetName · @b.DateIssued.ToString("MMM dd")</div>
                                </td>
                                <td class="cell-strong">@($"₱{b.TotalAmount:N2}")</td>
                                <td><a class="btn-vc btn-vc-sm" asp-controller="Billing" asp-action="Details" asp-route-id="@b.InvoiceID">Pay now</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state"><p>Nothing due — you're all settled! 🎉</p></div>
                }
            </div>
        </div>

        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Vaccination reminders</h3>
            </div>
            <div class="vc-card-body p-0 table-scroll">
                @if (Model.UpcomingReminders.Any())
                {
                    <table class="vc-table">
                        <thead><tr><th>Pet</th><th>Vaccine</th><th>Due</th></tr></thead>
                        <tbody>
                        @foreach (var r in Model.UpcomingReminders)
                        {
                            <tr>
                                <td class="cell-strong">@r.Pet?.PetName</td>
                                <td>@r.VaccineName</td>
                                <td class="cell-strong">@r.DueDate.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state"><p>No upcoming vaccination reminders.</p></div>
                }
            </div>
        </div>
    </div>
</div>
