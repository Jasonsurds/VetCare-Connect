@model VetCare.ViewModels.AdminDashboardViewModel
@{
    Layout = "_DashboardLayout";
    var revenueByMonth = Model.MonthlyRevenue
        .GroupBy(b => b.DateIssued.ToString("MMM yyyy"))
        .Select(g => new { Month = g.Key, Total = g.Sum(b => b.TotalAmount) })
        .ToList();
}

<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon si-teal">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="4" r="2"></circle><circle cx="18" cy="8" r="2"></circle><circle cx="6" cy="8" r="2"></circle><path d="M12 11c-3 0-5.5 2.5-5.5 5.5S9 22 12 22s5.5-2.5 5.5-5.5S15 11 12 11z"></path></svg>
        </div>
        <div><div class="stat-number">@Model.TotalPets</div><div class="stat-label">Registered Pets</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-purple">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
        </div>
        <div><div class="stat-number">@Model.TotalOwners</div><div class="stat-label">Pet Owners</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-green">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
        </div>
        <div><div class="stat-number">@($"₱{Model.CollectedAmount:N0}")</div><div class="stat-label">Collected (Paid)</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-amber">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
        </div>
        <div><div class="stat-number">@($"₱{Model.PendingAmount:N0}")</div><div class="stat-label">@Model.PendingInvoices Pending Invoice(s)</div></div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Revenue — last 6 months</h3>
                <a class="vc-card-link" asp-controller="Reports" asp-action="Index">Open reports →</a>
            </div>
            <div class="vc-card-body">
                @if (revenueByMonth.Any())
                {
                    <div class="chart-wrap"><canvas id="revenueChart"></canvas></div>
                }
                else
                {
                    <div class="empty-state">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                        <p>No paid invoices yet — revenue will appear here.</p>
                    </div>
                }
            </div>
        </div>

        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Today's appointments (@Model.TodayAppointments.Count)</h3>
                <a class="vc-card-link" asp-controller="Appointments" asp-action="Index">Manage all →</a>
            </div>
            <div class="vc-card-body p-0 table-scroll">
                @if (Model.TodayAppointments.Any())
                {
                    <table class="vc-table">
                        <thead><tr><th>Time</th><th>Pet</th><th>Owner</th><th>Vet</th><th>Service</th><th>Status</th></tr></thead>
                        <tbody>
                        @foreach (var a in Model.TodayAppointments)
                        {
                            <tr>
                                <td class="cell-strong">@a.AppointmentDate.ToString("h:mm tt")</td>
                                <td>@a.Pet?.PetName <span class="cell-muted">(@a.Pet?.Species)</span></td>
                                <td>@a.Pet?.Owner?.Name</td>
                                <td>@a.Vet?.Name</td>
                                <td>@a.ServiceType</td>
                                <td><partial name="_StatusBadge" model="a.Status" /></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        <p>No appointments scheduled for today.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Low stock alerts (@Model.LowStockItems.Count)</h3>
                <a class="vc-card-link" asp-controller="Inventory" asp-action="Index">Inventory →</a>
            </div>
            <div class="vc-card-body p-0 table-scroll">
                @if (Model.LowStockItems.Any())
                {
                    <table class="vc-table">
                        <thead><tr><th>Item</th><th>Stock</th><th>Reorder at</th></tr></thead>
                        <tbody>
                        @foreach (var i in Model.LowStockItems)
                        {
                            <tr>
                                <td class="cell-strong">@i.ItemName</td>
                                <td><span class="badge-vc b-low">@i.Quantity left</span></td>
                                <td class="cell-muted">@i.ReorderLevel</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state"><p>Stock levels are healthy. 🎉</p></div>
                }
            </div>
        </div>

        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Reminders due (7 days)</h3>
                <a class="vc-card-link" asp-controller="VaccinationReminders" asp-action="Index">Reminders →</a>
            </div>
            <div class="vc-card-body">
                <div class="stat-card" style="box-shadow:none; border:none; padding:0;">
                    <div class="stat-icon si-blue">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path></svg>
                    </div>
                    <div><div class="stat-number">@Model.RemindersDue</div><div class="stat-label">vaccination reminder(s) due within a week</div></div>
                </div>
            </div>
        </div>

        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Recent system activity</h3>
                <a class="vc-card-link" asp-controller="AuditLogs" asp-action="Index">Full audit log →</a>
            </div>
            <div class="vc-card-body p-0 table-scroll">
                @if (Model.RecentAuditLogs.Any())
                {
                    <table class="vc-table">
                        <tbody>
                        @foreach (var log in Model.RecentAuditLogs)
                        {
                            <tr>
                                <td>
                                    <div class="cell-strong">@log.Action — @log.EntityName</div>
                                    <div class="cell-muted">@log.UserName · @log.Timestamp.ToString("MMM dd, h:mm tt")</div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state"><p>No activity recorded yet.</p></div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    @if (revenueByMonth.Any())
    {
        <script>
            new Chart(document.getElementById('revenueChart'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(revenueByMonth.Select(r => r.Month))),
                    datasets: [{
                        label: 'Collected (₱)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(revenueByMonth.Select(r => r.Total))),
                        backgroundColor: 'rgba(11, 94, 82, 0.75)',
                        hoverBackgroundColor: '#0b5e52',
                        borderRadius: 8,
                        maxBarThickness: 46
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, grid: { color: '#eef5f3' }, ticks: { color: '#79948e' } },
                        x: { grid: { display: false }, ticks: { color: '#79948e' } }
                    }
                }
            });
        </script>
    }
}
