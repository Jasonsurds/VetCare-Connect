@model VetCare.ViewModels.AdminDashboardViewModel
@{
    Layout = "_DashboardLayout";
    var revenueByMonth = Model.MonthlyRevenue
        .GroupBy(b => b.DateIssued.ToString("MMM yyyy"))
        .Select(g => new { Month = g.Key, Total = g.Sum(b => b.TotalAmount) })
        .ToList();
}

<div class="stat-grid">
    <!-- Stat 1: Registered Pets -->
    <a asp-controller="Pets" asp-action="Index" class="stat-card">
        <div class="stat-icon si-teal">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="4" r="2"></circle>
                <circle cx="18" cy="8" r="2"></circle>
                <circle cx="6" cy="8" r="2"></circle>
                <path d="M12 11c-3 0-5.5 2.5-5.5 5.5S9 22 12 22s5.5-2.5 5.5-5.5S15 11 12 11z"></path>
            </svg>
        </div>
        <div class="stat-info">
            <div class="stat-label">Registered Pets</div>
            <div class="stat-number">@Model.TotalPets</div>
            <div class="stat-trend trend-up">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="7 17 17 7"></polyline><polyline points="7 7 17 7 17 17"></polyline></svg>
                <span>+2 this month</span>
            </div>
        </div>
    </a>

    <!-- Stat 2: Pet Owners -->
    <a asp-controller="Owners" asp-action="Index" class="stat-card">
        <div class="stat-icon si-purple">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
            </svg>
        </div>
        <div class="stat-info">
            <div class="stat-label">Pet Owners</div>
            <div class="stat-number">@Model.TotalOwners</div>
            <div class="stat-trend trend-up">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="7 17 17 7"></polyline><polyline points="7 7 17 7 17 17"></polyline></svg>
                <span>+1 this month</span>
            </div>
        </div>
    </a>

    <!-- Stat 3: Collected (Paid) -->
    <a asp-controller="Billing" asp-action="Index" class="stat-card">
        <div class="stat-icon si-green">
            <span style="font-size: 1.25rem; font-weight: 800; line-height: 1;">₱</span>
        </div>
        <div class="stat-info">
            <div class="stat-label">Collected (Paid)</div>
            <div class="stat-number">@($"₱{Model.CollectedAmount:N0}")</div>
            <div class="stat-trend trend-up">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="7 17 17 7"></polyline><polyline points="7 7 17 7 17 17"></polyline></svg>
                <span>+15% this month</span>
            </div>
        </div>
    </a>

    <!-- Stat 4: Pending Invoice(s) -->
    <a asp-controller="Billing" asp-action="Index" class="stat-card">
        <div class="stat-icon si-amber">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
            </svg>
        </div>
        <div class="stat-info">
            <div class="stat-label">Pending Invoice(s)</div>
            <div class="stat-number">@($"₱{Model.PendingAmount:N0}")</div>
            <div class="stat-trend trend-neutral">
                <span>@(Model.PendingInvoices > 0 ? $"{Model.PendingInvoices} pending invoice(s)" : "No pending invoices")</span>
            </div>
        </div>
    </a>
</div>

<div class="row g-4">
    <!-- Left Column: Revenue Chart & Appointments -->
    <div class="col-lg-7">
        <!-- Revenue Chart Card -->
        <div class="vc-card">
            <div class="vc-card-head">
                <div>
                    <h3 class="vc-card-title">Revenue — Last 6 Months</h3>
                    <div class="vc-card-subtitle">Total collected payments from services and products</div>
                </div>
                <a class="vc-card-link" asp-controller="Reports" asp-action="Index">
                    <span>Open reports</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
            </div>
            <div class="vc-card-body">
                @if (revenueByMonth.Any())
                {
                    <div class="chart-wrap"><canvas id="revenueChart"></canvas></div>
                }
                else
                {
                    <div class="empty-state">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                        <p>No paid invoices yet — revenue will appear here.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Today's Appointments -->
        <div class="vc-card">
            <div class="vc-card-head">
                <div class="d-flex align-items-center gap-2">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#239e85" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    <h3 class="vc-card-title">Today's appointments (@Model.TodayAppointments.Count)</h3>
                </div>
                <a class="vc-card-link" asp-controller="Appointments" asp-action="Index">
                    <span>Manage all</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
            </div>
            <div class="vc-card-body p-0 table-scroll">
                @if (Model.TodayAppointments.Any())
                {
                    <table class="vc-table">
                        <thead><tr><th>Time</th><th>Pet</th><th>Owner</th><th>Vet</th><th>Service</th><th>Status</th></tr></thead>
                        <tbody>
                        @foreach (var a in Model.TodayAppointments)
                        {
                            <tr>
                                <td class="cell-strong">@a.AppointmentDate.ToString("h:mm tt")</td>
                                <td>@a.Pet?.PetName <span class="cell-muted">(@a.Pet?.Species)</span></td>
                                <td>@a.Pet?.Owner?.Name</td>
                                <td>@a.Vet?.Name</td>
                                <td>@a.ServiceType</td>
                                <td><partial name="_StatusBadge" model="a.Status" /></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state py-4">
                        <div class="d-inline-flex p-3 rounded-circle bg-light mb-2">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#239e85" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        </div>
                        <div class="fw-bold text-dark">No appointments today</div>
                        <p class="text-muted small">You're all caught up! No scheduled appointments for today.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Low Stock Alerts, Reminders, Activity -->
    <div class="col-lg-5">
        <!-- Low Stock Alerts -->
        <div class="vc-card">
            <div class="vc-card-head">
                <div class="d-flex align-items-center gap-2">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#239e85" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                    <h3 class="vc-card-title">Low stock alerts (@Model.LowStockItems.Count)</h3>
                </div>
                <a class="vc-card-link" asp-controller="Inventory" asp-action="Index">
                    <span>View inventory</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
            </div>
            <div class="vc-card-body p-0 table-scroll">
                @if (Model.LowStockItems.Any())
                {
                    <table class="vc-table">
                        <thead><tr><th>Item</th><th>Stock</th><th>Reorder at</th></tr></thead>
                        <tbody>
                        @foreach (var i in Model.LowStockItems)
                        {
                            <tr>
                                <td class="cell-strong">@i.ItemName</td>
                                <td><span class="badge-vc b-low">@i.Quantity left</span></td>
                                <td class="cell-muted">@i.ReorderLevel</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="healthy-stock-box">
                        <div class="healthy-icon-pill">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="4" r="2"></circle>
                                <circle cx="18" cy="8" r="2"></circle>
                                <circle cx="6" cy="8" r="2"></circle>
                                <path d="M12 11c-3 0-5.5 2.5-5.5 5.5S9 22 12 22s5.5-2.5 5.5-5.5S15 11 12 11z"></path>
                            </svg>
                        </div>
                        <div>
                            <div class="fw-bold text-dark mb-1" style="font-size: 0.92rem;">Stock levels are healthy.</div>
                            <div class="text-muted small">No items are running low at the moment.</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Vaccination Reminders Due -->
        <div class="vc-card">
            <div class="vc-card-head">
                <div class="d-flex align-items-center gap-2">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#239e85" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                    <h3 class="vc-card-title">Reminders due (7 days)</h3>
                </div>
                <a class="vc-card-link" asp-controller="VaccinationReminders" asp-action="Index">
                    <span>View all</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
            </div>
            <div class="vc-card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon si-teal" style="width: 44px; height: 44px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="stat-number" style="font-size: 1.3rem;">@Model.RemindersDue</div>
                        <div class="text-muted small">Vaccination reminder(s) due within a week.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent System Activity -->
        <div class="vc-card">
            <div class="vc-card-head">
                <div class="d-flex align-items-center gap-2">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#239e85" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    <h3 class="vc-card-title">Recent system activity</h3>
                </div>
                <a class="vc-card-link" asp-controller="AuditLogs" asp-action="Index">
                    <span>View log</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
            </div>
            <div class="vc-card-body p-0">
                @if (Model.RecentAuditLogs.Any())
                {
                    <div class="activity-list">
                        @foreach (var log in Model.RecentAuditLogs)
                        {
                            <div class="activity-item">
                                <div class="activity-dot"></div>
                                <div>
                                    <div class="activity-title">@log.Action — @log.EntityName</div>
                                    <div class="activity-sub">@log.UserName</div>
                                </div>
                                <div class="activity-time">@log.Timestamp.ToString("MMM dd, h:mm tt")</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state py-4"><p>No activity recorded yet.</p></div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    @if (revenueByMonth.Any())
    {
        <script>
            new Chart(document.getElementById('revenueChart'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(revenueByMonth.Select(r => r.Month))),
                    datasets: [{
                        label: 'Collected (₱)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(revenueByMonth.Select(r => r.Total))),
                        backgroundColor: '#239e85',
                        hoverBackgroundColor: '#188673',
                        borderRadius: 6,
                        maxBarThickness: 42
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { 
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#084338',
                            titleFont: { family: 'Plus Jakarta Sans', weight: 'bold' },
                            bodyFont: { family: 'Plus Jakarta Sans' },
                            padding: 10,
                            cornerRadius: 8
                        }
                    },
                    scales: {
                        y: { 
                            beginAtZero: true, 
                            grid: { color: '#e8f2ef', drawBorder: false }, 
                            ticks: { 
                                color: '#718e87',
                                font: { family: 'Plus Jakarta Sans', size: 11 },
                                callback: function(value) { return '₱' + value.toLocaleString(); }
                            } 
                        },
                        x: { 
                            grid: { display: false, drawBorder: false }, 
                            ticks: { color: '#718e87', font: { family: 'Plus Jakarta Sans', size: 11 } } 
                        }
                    }
                }
            });
        </script>
    }
}
