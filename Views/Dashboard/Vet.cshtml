@model VetCare.ViewModels.VetDashboardViewModel
@{
    Layout = "_DashboardLayout";
}

<div class="stat-grid cols-3">
    <div class="stat-card">
        <div class="stat-icon si-teal">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        </div>
        <div><div class="stat-number">@Model.TodayAppointments.Count</div><div class="stat-label">Consultations Today</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-amber">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
        </div>
        <div><div class="stat-number">@Model.CompletedWithoutRecord.Count</div><div class="stat-label">Records to Write</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon si-purple">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="4" r="2"></circle><circle cx="18" cy="8" r="2"></circle><circle cx="6" cy="8" r="2"></circle><path d="M12 11c-3 0-5.5 2.5-5.5 5.5S9 22 12 22s5.5-2.5 5.5-5.5S15 11 12 11z"></path></svg>
        </div>
        <div><div class="stat-number">@Model.TotalPatients</div><div class="stat-label">Patients Under My Care</div></div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">My schedule today</h3>
                <a class="vc-card-link" asp-controller="Appointments" asp-action="Index">Full schedule →</a>
            </div>
            <div class="vc-card-body p-0 table-scroll">
                @if (Model.TodayAppointments.Any())
                {
                    <table class="vc-table">
                        <thead><tr><th>Time</th><th>Pet</th><th>Owner</th><th>Service</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var a in Model.TodayAppointments)
                        {
                            <tr>
                                <td class="cell-strong">@a.AppointmentDate.ToString("h:mm tt")</td>
                                <td>@a.Pet?.PetName <span class="cell-muted">(@a.Pet?.Species)</span></td>
                                <td>@a.Pet?.Owner?.Name</td>
                                <td>@a.ServiceType</td>
                                <td><partial name="_StatusBadge" model="a.Status" /></td>
                                <td><a class="btn-vc-outline btn-vc-sm" asp-controller="Appointments" asp-action="Details" asp-route-id="@a.AppointmentID">Open</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        <p>No consultations scheduled for today.</p>
                    </div>
                }
            </div>
        </div>

        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Upcoming appointments</h3>
            </div>
            <div class="vc-card-body p-0 table-scroll">
                @if (Model.UpcomingAppointments.Any())
                {
                    <table class="vc-table">
                        <thead><tr><th>Date</th><th>Pet</th><th>Service</th><th>Status</th></tr></thead>
                        <tbody>
                        @foreach (var a in Model.UpcomingAppointments)
                        {
                            <tr>
                                <td class="cell-strong">@a.AppointmentDate.ToString("MMM dd, h:mm tt")</td>
                                <td>@a.Pet?.PetName</td>
                                <td>@a.ServiceType</td>
                                <td><partial name="_StatusBadge" model="a.Status" /></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state"><p>No upcoming appointments.</p></div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Awaiting treatment records</h3>
            </div>
            <div class="vc-card-body p-0 table-scroll">
                @if (Model.CompletedWithoutRecord.Any())
                {
                    <table class="vc-table">
                        <thead><tr><th>Date</th><th>Pet</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var a in Model.CompletedWithoutRecord)
                        {
                            <tr>
                                <td class="cell-muted">@a.AppointmentDate.ToString("MMM dd")</td>
                                <td class="cell-strong">@a.Pet?.PetName</td>
                                <td><a class="btn-vc btn-vc-sm" asp-controller="TreatmentRecords" asp-action="Create" asp-route-appointmentId="@a.AppointmentID">Write record</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state"><p>All completed visits are documented. 👍</p></div>
                }
            </div>
        </div>

        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Reminders due soon</h3>
                <a class="vc-card-link" asp-controller="VaccinationReminders" asp-action="Index">Manage →</a>
            </div>
            <div class="vc-card-body p-0 table-scroll">
                @if (Model.RemindersToSet.Any())
                {
                    <table class="vc-table">
                        <thead><tr><th>Pet</th><th>Vaccine</th><th>Due</th></tr></thead>
                        <tbody>
                        @foreach (var r in Model.RemindersToSet)
                        {
                            <tr>
                                <td class="cell-strong">@r.Pet?.PetName</td>
                                <td>@r.VaccineName</td>
                                <td class="cell-muted">@r.DueDate.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state"><p>No reminders due in the next 7 days.</p></div>
                }
            </div>
        </div>
    </div>
</div>
