@model VetCare.Models.Appointment
@{
    Layout = "_DashboardLayout";
    var role = User.GetUserRole();
    var canManage = role is "Administrator" or "Clinic Staff";
    var canComplete = role == "Veterinarian" && Model.VetID == User.GetUserId();
    var canCancel = canManage || (role == "Pet Owner" && Model.Pet!.OwnerID == User.GetUserId() && (Model.Status == "Pending" || Model.Status == "Confirmed"));
    var canDelete = role == "Administrator" || (role == "Pet Owner" && Model.Pet!.OwnerID == User.GetUserId());
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Appointment details</h3>
                <partial name="_StatusBadge" model="Model.Status" />
            </div>
            <div class="vc-card-body">
                <div class="row g-3" style="font-size:.92rem;">
                    <div class="col-md-6">
                        <div class="form-hint">PET</div>
                        <div class="cell-strong">@Model.Pet?.PetName (@Model.Pet?.Species)</div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-hint">OWNER</div>
                        <div class="cell-strong">@Model.Pet?.Owner?.Name</div>
                        <div class="cell-muted">@(Model.Pet?.Owner?.ContactNumber ?? "—")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-hint">VETERINARIAN</div>
                        <div class="cell-strong">@Model.Vet?.Name</div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-hint">DATE &amp; TIME</div>
                        <div class="cell-strong">@Model.AppointmentDate.ToString("dddd, MMM dd, yyyy")</div>
                        <div class="cell-muted">@Model.AppointmentDate.ToString("h:mm tt")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-hint">SERVICE</div>
                        <div class="cell-strong">@Model.ServiceType</div>
                    </div>
                    <div class="col-12">
                        <div class="form-hint">NOTES</div>
                        <div>@(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4 flex-wrap">
                    @if (Model.Status == "Pending" && canManage)
                    {
                        <form asp-action="Approve" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.AppointmentID" />
                            <button class="btn-vc" type="submit">Approve appointment</button>
                        </form>
                    }
                    @if (Model.Status == "Pending" && canCancel)
                    {
                        <form asp-action="Cancel" method="post" class="d-inline" data-confirm="Cancel this appointment?">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.AppointmentID" />
                            <button class="btn-vc-outline btn-vc-danger" type="submit">Cancel appointment</button>
                        </form>
                    }
                    @if (canDelete)
                    {
                        var deleteMsg = role == "Pet Owner" && Model.Status == "Completed"
                            ? "Delete this completed appointment? Its treatment record and invoice will also be removed. This cannot be undone."
                            : "Permanently delete this appointment?";
                        <form asp-action="Delete" method="post" class="d-inline" data-confirm="@deleteMsg">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.AppointmentID" />
                            <button class="btn-vc-outline btn-vc-danger" type="submit">Delete</button>
                        </form>
                    }
                    <a class="btn-vc-outline" asp-action="Index">Back to list</a>
                </div>
            </div>
        </div>

        @if (Model.Status == "Confirmed" && canComplete)
        {
            var isMedical = Model.ServiceType is "General Checkup" or "Vaccination" or "Follow-up" or "Surgery Consult";
            if (isMedical)
            {
                var inventory = (IEnumerable<VetCare.Models.InventoryItem>?)ViewBag.InventoryItems;
                <div class="vc-card">
                    <div class="vc-card-head">
                        <h3 class="vc-card-title">Medicines used on this visit</h3>
                        <span class="badge-vc b-ok">Complete below</span>
                    </div>
                    <div class="vc-card-body">
                        <form asp-action="Complete" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.AppointmentID" />
                            @if (inventory != null && inventory.Any())
                            {
                                <div class="table-scroll">
                                    <table class="vc-table">
                                        <thead>
                                            <tr><th></th><th>Medicine</th><th>Unit price</th><th>In stock</th><th>Qty used</th></tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var m in inventory.OrderByDescending(m => m.Quantity > 0))
                                        {
                                            <tr>
                                                <td>
                                                    <input type="checkbox" name="usedItems" value="@m.ItemID" class="med-check" id="chk_@m.ItemID" @(m.Quantity <= 0 ? "disabled" : "") />
                                                </td>
                                                <td class="cell-strong">@m.ItemName <span class="cell-muted">(@m.Category)</span></td>
                                                <td>@($"₱{m.UnitPrice:N2}")</td>
                                                <td><span class="cell-muted">@m.Quantity</span></td>
                                                <td style="width:120px;">
                                                    <input type="number" name="qty_@m.ItemID" id="qty_@m.ItemID" class="form-control-vc" value="1" min="1" max="@Math.Max(m.Quantity, 1)" disabled />
                                                </td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                                <p class="page-note mt-2 mb-3">Tick every medicine you administered and set how many were used. They will be added to the owner's invoice and deducted from inventory automatically.</p>
                            }
                            else
                            {
                                <div class="empty-state"><p>No medicines in the inventory yet — you can still complete the visit.</p></div>
                            }
                            <div class="d-flex gap-2">
                                <button class="btn-vc" type="submit">Mark as completed</button>
                            </div>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="vc-card">
                    <div class="vc-card-head">
                        <h3 class="vc-card-title">Complete this visit</h3>
                        <span class="badge-vc b-ok">Complete below</span>
                    </div>
                    <div class="vc-card-body">
                        <form asp-action="Complete" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.AppointmentID" />
                            <p class="page-note mb-3">No medicines to record for this @Model.ServiceType service. Completing this visit will send the invoice to Billing.</p>
                            <div class="d-flex gap-2">
                                <button class="btn-vc" type="submit">Mark as completed</button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        }
    </div>

    <div class="col-lg-5">
        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Treatment record</h3>
            </div>
            <div class="vc-card-body">
                @if (Model.TreatmentRecord != null)
                {
                    <div style="font-size:.9rem;">
                        <p class="mb-2"><span class="form-hint">DIAGNOSIS</span><br />@Model.TreatmentRecord.Diagnosis</p>
                        <p class="mb-2"><span class="form-hint">PRESCRIPTION</span><br />@(string.IsNullOrWhiteSpace(Model.TreatmentRecord.Prescription) ? "—" : Model.TreatmentRecord.Prescription)</p>
                        <p class="mb-0"><span class="form-hint">TREATMENT NOTES</span><br />@(string.IsNullOrWhiteSpace(Model.TreatmentRecord.TreatmentNotes) ? "—" : Model.TreatmentRecord.TreatmentNotes)</p>
                    </div>
                }
                else if (Model.Status == "Completed" && (canComplete || canManage))
                {
                    <div class="empty-state">
                        <p>This visit has no treatment record yet.</p>
                        <a class="btn-vc mt-2" asp-controller="TreatmentRecords" asp-action="Create" asp-route-appointmentId="@Model.AppointmentID">Write treatment record</a>
                    </div>
                }
                else
                {
                    <div class="empty-state"><p>Treatment record appears after the visit is completed.</p></div>
                }
            </div>
        </div>

        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Invoice</h3>
            </div>
            <div class="vc-card-body">
                @if (Model.Billing != null)
                {
                    <div style="font-size:.92rem;">
                        <p class="mb-2"><span class="cell-strong">Invoice:</span> #INV-@Model.Billing.InvoiceID.ToString("D4")</p>
                        <p class="mb-2"><span class="cell-strong">Amount:</span> @($"₱{Model.Billing.TotalAmount:N2}")</p>
                        <p class="mb-2"><span class="cell-strong">Method:</span> @Model.Billing.PaymentMethod</p>
                        <p class="mb-0"><span class="cell-strong">Status:</span> <partial name="_StatusBadge" model="Model.Billing.PaymentStatus" /></p>
                    </div>
                    <a class="btn-vc-outline mt-3" asp-controller="Billing" asp-action="Details" asp-route-id="@Model.Billing.InvoiceID">Open invoice</a>
                }
                else if (Model.Status == "Completed" && canManage)
                {
                    <div class="empty-state">
                        <p>No invoice on file for this visit (completed before automatic billing).</p>
                        <a class="btn-vc mt-2" asp-controller="Billing" asp-action="Create" asp-route-appointmentId="@Model.AppointmentID">Issue invoice manually</a>
                    </div>
                }
                else
                {
                    <div class="empty-state"><p>The bill is automatically sent to Billing once the consultation is completed.</p></div>
                }
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    document.querySelectorAll('.med-check').forEach(function (cb) {
        var row = document.getElementById('qty_' + cb.value);
        if (!row) return;
        row.disabled = !cb.checked;
        cb.addEventListener('change', function () {
            row.disabled = !cb.checked;
            if (!cb.checked) row.value = '1';
        });
    });
})();
</script>
