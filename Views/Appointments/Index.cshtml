@model IEnumerable<VetCare.Models.Appointment>
@{
    Layout = "_DashboardLayout";
    var role = User.GetUserRole();
    var canCreate = role is "Administrator" or "Clinic Staff" or "Pet Owner";
    var statuses = new[] { "All", "Pending", "Confirmed", "Completed", "Cancelled" };
    var current = ViewBag.Status as string ?? "All";
}

<div class="filter-row">
    <div class="d-flex gap-2 flex-wrap">
        @foreach (var s in statuses)
        {
            <a class="btn-vc-outline @(current == s ? "active-filter" : "")"
               style="@(current == s ? "background:var(--primary,#0b5e52);color:#fff;border-color:#0b5e52;" : "")"
               asp-action="Index" asp-route-status="@s" asp-route-search="@ViewBag.Search">@s</a>
        }
    </div>
    <form method="get" class="d-flex gap-2 flex-wrap ms-auto">
        <input type="hidden" name="status" value="@current" />
        <div class="search-box">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control-vc" placeholder="Search pet or vet..." />
        </div>
        <button class="btn-vc-outline" type="submit">Search</button>
    </form>
    @if (canCreate)
    {
        <a class="btn-vc" asp-action="Create">+ Book appointment</a>
    }
</div>

<div class="vc-card">
    <div class="vc-card-head">
        <h3 class="vc-card-title">Appointments (@Model.Count())</h3>
    </div>
    <div class="vc-card-body p-0 table-scroll">
        @if (Model.Any())
        {
            <table class="vc-table">
                <thead>
                    <tr>
                        <th>Date &amp; Time</th>
                        <th>Pet</th>
                        @if (role != "Pet Owner")
                        {
                            <th>Owner</th>
                        }
                        <th>Veterinarian</th>
                        <th>Service</th>
                        <th>Status</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="cell-strong">@a.AppointmentDate.ToString("MMM dd, yyyy")<div class="cell-muted">@a.AppointmentDate.ToString("h:mm tt")</div></td>
                        <td>@a.Pet?.PetName <span class="cell-muted">(@a.Pet?.Species)</span></td>
                        @if (role != "Pet Owner")
                        {
                            <td>@a.Pet?.Owner?.Name</td>
                        }
                        <td>@a.Vet?.Name</td>
                        <td>@a.ServiceType</td>
                        <td><partial name="_StatusBadge" model="a.Status" /></td>
                        <td style="text-align:right; white-space:nowrap;">
                            <a class="btn-vc-outline btn-vc-sm" asp-action="Details" asp-route-id="@a.AppointmentID">Open</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                <p>No appointments found for this filter.</p>
            </div>
        }
    </div>
</div>
