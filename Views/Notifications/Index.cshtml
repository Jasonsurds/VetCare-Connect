@model IEnumerable<VetCare.Models.Notification>
@{
    Layout = "_DashboardLayout";
    var filter = (ViewBag.Filter as string) ?? "all";
    var unreadCount = (int)(ViewBag.UnreadCount ?? 0);
    var filterLower = filter.ToLowerInvariant();
    var filters = new[]
    {
        ("all", "All"),
        ("unread", $"Unread {(unreadCount > 0 ? $"({unreadCount})" : "")}"),
        ("appointments", "📅 Appointments"),
        ("billing", "💳 Billing & Payments"),
        ("reminders", "💉 Reminders")
    };
}

<div class="filter-row">
    <div class="d-flex gap-2 flex-wrap">
        @foreach (var (key, label) in filters)
        {
            var isActive = (filterLower == key) || (key == "all" && filterLower == "");
            <a class="btn-vc-outline"
               style="@(isActive ? "background:var(--primary,#0b5e52);color:#fff;border-color:#0b5e52;" : "")"
               asp-action="Index" asp-route-filter="@key">@label</a>
        }
    </div>

    @if (unreadCount > 0)
    {
        <form asp-action="MarkAllRead" method="post" class="ms-auto">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
            <button type="submit" class="btn-vc-outline btn-vc-sm">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                Mark all as read (@unreadCount)
            </button>
        </form>
    }
</div>

<div class="vc-card">
    <div class="vc-card-head d-flex align-items-center justify-content-between">
        <h3 class="vc-card-title">Notifications (@Model.Count())</h3>
        <span class="cell-muted" style="font-size:0.82rem;">Real-time transaction &amp; clinic alerts</span>
    </div>
    <div class="vc-card-body p-0">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <p>No notifications found in this view.</p>
                <div class="cell-muted small mt-1">You're all caught up! New transaction notifications will appear here.</div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column">
                @foreach (var item in Model)
                {
                    var catIcon = item.Category switch
                    {
                        "Appointment" => "📅",
                        "Billing" => "💳",
                        "Reminder" => "💉",
                        _ => "🔔"
                    };

                    var catBadgeClass = item.Category switch
                    {
                        "Appointment" => "background:#e0f2fe; color:#0369a1;",
                        "Billing" => "background:#fef3c7; color:#92400e;",
                        "Reminder" => "background:#fce7f3; color:#9d174d;",
                        _ => "background:#e6f4f1; color:#0b5e52;"
                    };

                    <div class="p-3 border-bottom d-flex align-items-start gap-3 transition-all"
                         style="@(!item.IsRead ? "background:rgba(11,107,97,0.04); border-left:4px solid #0b6b61;" : "background:#fff;")">
                        
                        <div style="width:40px; height:40px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:1.15rem; flex-shrink:0; @catBadgeClass">
                            @catIcon
                        </div>

                        <div class="flex-grow-1" style="min-width:0;">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-1">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="cell-strong" style="font-size:0.95rem;">@item.Title</span>
                                    @if (!item.IsRead)
                                    {
                                        <span class="badge" style="background:#0b6b61; color:#fff; font-size:0.65rem; font-weight:800; letter-spacing:0.5px; border-radius:6px; padding:3px 6px;">NEW</span>
                                    }
                                </div>
                                <span class="cell-muted" style="font-size:0.78rem;">@item.CreatedAt.ToString("MMM dd, yyyy · h:mm tt")</span>
                            </div>

                            <p class="mb-2" style="font-size:0.88rem; color:#475569; line-height:1.45;">@item.Message</p>

                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrEmpty(item.ActionUrl))
                                {
                                    <a href="@item.ActionUrl" class="btn-vc-outline btn-vc-sm" style="padding:3px 10px; font-size:0.78rem; text-decoration:none;">
                                        View details &rarr;
                                    </a>
                                }
                                @if (!item.IsRead)
                                {
                                    <form asp-action="MarkRead" method="post" class="d-inline m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.NotificationID" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="btn-link-action text-muted small p-0 border-0 bg-transparent" style="cursor:pointer; font-size:0.78rem;">
                                            Mark as read
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
