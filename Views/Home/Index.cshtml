@{
    ViewData["Title"] = "Streamlined Veterinary Care, Smarter Clinics";
}

<!-- Hero Section -->
<section id="home" class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <!-- Left Column: Copy & Stats -->
            <div class="col-lg-6">
                <div class="category-badge">
                    <span>🐾</span> Welcome to VetCare Connect
                </div>
                <h1 class="hero-title">
                    Streamlined Veterinary Care, Smarter Clinics
                </h1>
                <p class="hero-subtitle">
                    Connecting pet owners, veterinarians, and clinics in one unified platform. Manage appointments, medical records, billing, inventory, and more — all in one place.
                </p>
                
                <div class="hero-actions">
                    <button class="btn-vc-primary open-appointment-modal">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        Book an appointment
                    </button>
                    <a href="#features" class="btn-vc-outline">
                        Learn More 
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                </div>

                <!-- Stats Grid -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-number">10,000+</div>
                        <div class="stat-label">Pets Managed</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number">98%</div>
                        <div class="stat-label">Happy Health Outcomes</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number">40%</div>
                        <div class="stat-label">Faster Booking Process</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number">150+</div>
                        <div class="stat-label">Partner Clinics</div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Visual Box with Doctor Card -->
            <div class="col-lg-6">
                <div class="hero-visual-wrapper">
                    <!-- Floating Badge -->
                    <div class="floating-badge">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        Specialist Care • Verified Professionals
                    </div>

                    <!-- Main Hero Image -->
                    <div class="hero-image-card">
                        <img src="~/images/vet-care.png" alt="Veterinarian caring for cat" class="hero-img" />

                        <!-- Doctor Card Overlay -->
                        <div class="doctor-overlay-card">
                            <div class="doctor-info-header">
                                <div class="doctor-avatar-wrapper">
                                    <img src="~/images/vet-care.png" alt="Dr. Sarah Chen" class="doctor-avatar" />
                                    <div>
                                        <div class="doctor-name">Dr. Sarah Chen</div>
                                        <div class="doctor-role">Senior Vet Practitioner</div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="status-badge-live">
                                        <span class="status-dot"></span> Available Today
                                    </div>
                                    <div class="doctor-rating mt-1">4.9 ★ (120+)</div>
                                </div>
                            </div>

                            <div class="doctor-quick-actions">
                                <button class="btn-action-tag open-appointment-modal">Schedule Visit</button>
                                <button class="btn-action-tag" onclick="window.showToast('Connecting to Dr. Sarah Chen via Direct Chat...'); return false;">Direct Chat</button>
                                <button class="btn-action-tag" onclick="window.showToast('Prescription refill module loaded'); return false;">Prescribe</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 1: Platform Features -->
<section id="features" class="section-padding bg-white">
    <div class="container">
        <div class="section-header">
            <div class="category-badge">PLATFORM FEATURES</div>
            <h2 class="section-title">Everything Your Clinic Needs</h2>
            <p class="section-subtitle">
                From patient registration to inventory management — VetCare Connect streamlines every aspect of clinic operations.
            </p>
        </div>

        <div class="features-grid">
            <!-- Feature 1 -->
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                </div>
                <h3 class="feature-card-title">Pet Owner Records</h3>
                <p class="feature-card-desc">
                    Centralizing pet medical histories, vaccination logs, weight tracking, dietary notes, and allergy alerts.
                </p>
            </div>

            <!-- Feature 2 -->
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </div>
                <h3 class="feature-card-title">Smart Appointment Scheduling</h3>
                <p class="feature-card-desc">
                    Seamless online booking with real-time slot management, automated reminders, and cancellation protection.
                </p>
            </div>

            <!-- Feature 3 -->
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                    </svg>
                </div>
                <h3 class="feature-card-title">Treatment & Prescriptions</h3>
                <p class="feature-card-desc">
                    Digital prescriptions, treatment tracking, and doctor notes management with immediate owner accessibility.
                </p>
            </div>

            <!-- Feature 4 -->
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    </svg>
                </div>
                <h3 class="feature-card-title">Medicine Inventory</h3>
                <p class="feature-card-desc">
                    Live stock monitoring, low-stock alerts, auto-reordering, and medicine batch expiration tracking.
                </p>
            </div>

            <!-- Feature 5 -->
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                        <line x1="2" y1="10" x2="22" y2="10"></line>
                    </svg>
                </div>
                <h3 class="feature-card-title">Billing & Payments</h3>
                <p class="feature-card-desc">
                    Seamless invoice generation, multi-currency support, payment gateways, and automated receipt delivery.
                </p>
            </div>

            <!-- Feature 6 -->
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>
                    </svg>
                </div>
                <h3 class="feature-card-title">Analytics & Reports</h3>
                <p class="feature-card-desc">
                    Clinical, financial, and operational intelligence dashboards with customizable reporting.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Section 3: Role-Based Portals -->
<section id="portals" class="section-padding bg-white">
    <div class="container">
        <div class="section-header">
            <div class="category-badge">ROLE-BASED PORTALS</div>
            <h2 class="section-title">A Portal for Everyone</h2>
            <p class="section-subtitle">Tailored experiences for each role in the veterinary ecosystem.</p>
        </div>

        <!-- Role Tabs -->
        <div class="portals-tabs-nav">
            <button class="portal-tab-btn active" data-role="owner">Pet Owner</button>
            <button class="portal-tab-btn" data-role="vet">Veterinarian</button>
            <button class="portal-tab-btn" data-role="staff">Clinic Staff</button>
            <button class="portal-tab-btn" data-role="admin">Administrator</button>
            <button class="portal-tab-btn" data-role="supplier">Supplier</button>
        </div>

        <!-- Dynamic Portal Display Card -->
        <div class="portal-display-card">
            <div class="row align-items-center">
                <div class="col-lg-6 portal-content-left">
                    <div class="portal-role-icon" id="portalRoleIcon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                    </div>
                    <h3 class="portal-role-title" id="portalRoleTitle">Pet Owner Portal</h3>
                    <p class="portal-role-desc" id="portalRoleDesc">
                        Easily schedule appointments, track pet health records, manage billing, and receive vaccination reminders.
                    </p>

                    <div class="portal-feature-pills" id="portalPillsContainer">
                        <span class="portal-subpill">Pet Profiles</span>
                        <span class="portal-subpill">Book Appointments</span>
                        <span class="portal-subpill">View Records</span>
                        <span class="portal-subpill">Pay Bills</span>
                        <span class="portal-subpill">Vet Direct Chat</span>
                    </div>

                    <div>
                        <button class="btn-vc-primary open-appointment-modal" id="portalCtaBtn">
                            Open Pet Owner Portal
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="portal-img-container">
                        <img src="~/images/happy-dog.png" alt="Pet Portal Preview" class="portal-img" id="portalImg" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section 4: Call to Action Value Banner -->
<section class="cta-banner-section">
    <div class="container text-center">
        <h2 class="cta-title">
            Better Care for Pets,<br />Stronger Clinic Efficiency
        </h2>
        <p class="cta-subtitle">
            VetCare Connect bridges the gap between compassionate care and smart clinic management — creating healthier communities, one pet at a time.
        </p>

        <div class="cta-cards-grid">
            <div class="cta-glass-card">
                <div class="cta-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                    </svg>
                </div>
                <h3 class="cta-card-title">Pet-Centered Care</h3>
                <p class="cta-card-desc">Prioritizing animal health and wellness with personalized treatment plans.</p>
            </div>

            <div class="cta-glass-card">
                <div class="cta-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                </div>
                <h3 class="cta-card-title">Clinic Efficiency</h3>
                <p class="cta-card-desc">Streamline workflow and reduce admin burden by up to 40% with smart automation.</p>
            </div>

            <div class="cta-glass-card">
                <div class="cta-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </div>
                <h3 class="cta-card-title">Healthier Communities</h3>
                <p class="cta-card-desc">Foster stronger bonds between pet parents, vets, and care providers.</p>
            </div>
        </div>
    </div>
</section>

<!-- Footer -->
<footer id="contact" class="vc-footer">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="footer-brand">
                    <div class="vc-brand-logo" style="background:transparent; box-shadow:none;">
                        <img src="~/images/logo-mark.png" alt="VetCare logo" style="width:26px; height:26px; object-fit:contain;" />
                    </div>
                    <span>VetCare Connect</span>
                </div>
                <p class="footer-desc">
                    Better care, happier pets. The complete veterinary clinic & pet owner ecosystem.
                </p>
            </div>

            <div class="col-lg-2 col-md-6">
                <div class="footer-heading">Quick Links</div>
                <ul class="footer-links">
                    <li><a href="#home">Home</a></li>
                    <li><a href="#features">Features</a></li>
                    <li><a href="#modules">Modules</a></li>
                    <li><a href="#portals">About Us</a></li>
                    <li><a href="#contact">Contact</a></li>
                </ul>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="footer-heading">Portals</div>
                <ul class="footer-links">
                    <li><a href="#portals">Pet Owner</a></li>
                    <li><a href="#portals">Veterinarian</a></li>
                    <li><a href="#portals">Clinic Staff</a></li>
                    <li><a href="#portals">Administrator</a></li>
                    <li><a href="#portals">Supplier</a></li>
                </ul>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="footer-heading">Contact</div>
                <ul class="footer-links">
                    <li>📧 support@vetcareconnect.com</li>
                    <li>📞 +1 (800) 334-8387</li>
                    <li>📍 123 Vet Ave, Suite 500<br />San Francisco, CA 94102</li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <div>© 2026 VetCare Connect. All rights reserved.</div>
            <div class="d-flex gap-3">
                <a href="#" class="text-decoration-none text-reset" onclick="window.showToast('Privacy Policy'); return false;">Privacy Policy</a>
                <a href="#" class="text-decoration-none text-reset" onclick="window.showToast('Terms of Service'); return false;">Terms of Service</a>
            </div>
        </div>
    </div>
</footer>
