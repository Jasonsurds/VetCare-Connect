@model VetCare.Models.Supplier
@{
    Layout = "_DashboardLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Edit supplier — @Model.SupplierName</h3>
                <a class="vc-card-link" asp-action="Index">← Back to suppliers</a>
            </div>
            <div class="vc-card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="SupplierID" />
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label-vc" asp-for="SupplierName">Supplier name *</label>
                            <input asp-for="SupplierName" class="form-control-vc" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-vc" asp-for="ContactInfo">Contact info</label>
                            <input asp-for="ContactInfo" class="form-control-vc" />
                        </div>
                        <div class="col-12">
                            <label class="form-label-vc" asp-for="ProductCatalog">Product catalog</label>
                            <textarea asp-for="ProductCatalog" class="form-control-vc"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label-vc" asp-for="ContractDetails">Contract details</label>
                            <textarea asp-for="ContractDetails" class="form-control-vc"></textarea>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn-vc">Save changes</button>
                        <a class="btn-vc-outline" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
