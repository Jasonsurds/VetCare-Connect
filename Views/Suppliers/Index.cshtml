@model IEnumerable<VetCare.Models.Supplier>
@{
    Layout = "_DashboardLayout";
    var isAdmin = User.GetUserRole() == "Administrator";
}

<div class="filter-row">
    <p class="page-note mb-0">Medicine and equipment suppliers with their contracts.</p>
    @if (isAdmin)
    {
        <a class="btn-vc ms-auto" asp-action="Create">+ Add supplier</a>
    }
</div>

<div class="row g-4">
    @foreach (var s in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="vc-card mb-0 h-100">
                <div class="vc-card-body">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="stat-icon si-teal" style="width:40px;height:40px;">
                            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 3h15v13H1z"></path><path d="M16 8h4l3 3v5h-7V8z"></path><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                        </div>
                        <h3 class="vc-card-title mb-0">@s.SupplierName</h3>
                    </div>
                    <p class="page-note mb-1"><span class="cell-strong">Contact:</span> @s.ContactInfo</p>
                    <p class="page-note mb-1"><span class="cell-strong">Catalog:</span> @s.ProductCatalog</p>
                    <p class="page-note mb-3"><span class="cell-strong">Contract:</span> @s.ContractDetails</p>
                    <span class="badge-vc b-info mb-3">@s.InventoryItems.Count supplied item(s)</span>
                    <div class="d-flex gap-2 flex-wrap">
                        <a class="btn-vc-outline btn-vc-sm" asp-action="Details" asp-route-id="@s.SupplierID">View</a>
                        @if (isAdmin)
                        {
                            <a class="btn-vc-outline btn-vc-sm" asp-action="Edit" asp-route-id="@s.SupplierID">Edit</a>
                            <form asp-action="Delete" method="post" data-confirm="Delete supplier '@s.SupplierName'?">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.SupplierID" />
                                <button class="btn-vc-outline btn-vc-sm btn-vc-danger" type="submit">Delete</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
@if (!Model.Any())
{
    <div class="vc-card"><div class="empty-state"><p>No suppliers registered yet.</p></div></div>
}
