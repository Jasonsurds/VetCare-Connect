@model VetCare.Models.Pet
@{
    Layout = "_DashboardLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Edit pet — @Model.PetName</h3>
                <a class="vc-card-link" asp-action="Index">← Back to pets</a>
            </div>
            <div class="vc-card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="PetID" />
                    <input type="hidden" asp-for="CreatedDate" />
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label-vc" asp-for="PetName">Pet name *</label>
                            <input asp-for="PetName" class="form-control-vc" />
                            <span asp-validation-for="PetName" class="field-validation-error"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-vc" asp-for="Species">Species *</label>
                            <select asp-for="Species" class="form-control-vc">
                                <option value="Dog">Dog</option>
                                <option value="Cat">Cat</option>
                                <option value="Bird">Bird</option>
                                <option value="Rabbit">Rabbit</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-vc" asp-for="Breed">Breed</label>
                            <input asp-for="Breed" list="breedSuggestions" class="form-control-vc" placeholder="Start typing or pick from suggestions" />
                            <div class="form-hint">Suggestions update based on species.</div>
                        </div>
                        <datalist id="breedSuggestions"></datalist>
                        <div class="col-md-6">
                            <label class="form-label-vc" asp-for="Age">Age (years) *</label>
                            <input asp-for="Age" type="number" min="0" max="50" class="form-control-vc" />
                        </div>
                        <div class="col-12">
                            <label class="form-label-vc" asp-for="OwnerID">Owner *</label>
                            <select asp-for="OwnerID" class="form-control-vc" asp-items="ViewBag.OwnerID">
                                <option value="">— Select owner —</option>
                            </select>
                            <span asp-validation-for="OwnerID" class="field-validation-error"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label-vc" asp-for="MedicalHistory">Medical history / notes</label>
                            <textarea asp-for="MedicalHistory" class="form-control-vc" placeholder="Vaccinations, allergies, past conditions..."></textarea>
                            <div class="d-flex align-items-center gap-2 mt-2">
                                <select id="quickNotesDropdown" class="form-control-vc" style="max-width: 340px;">
                                    <option value="">— Select a quick note to add —</option>
                                    <option value="Vaccinations up to date">Vaccinations up to date</option>
                                    <option value="Fully dewormed">Fully dewormed</option>
                                    <option value="No known allergies">No known allergies</option>
                                    <option value="Spayed / neutered">Spayed / neutered</option>
                                    <option value="On long-term medication">On long-term medication</option>
                                    <option value="Previous surgery">Previous surgery</option>
                                    <option value="Microchipped">Microchipped</option>
                                    <option value="Special diet required">Special diet required</option>
                                </select>
                                <button type="button" id="btnAddQuickNote" class="btn-vc-outline btn-vc-sm" style="height: 44px; padding: 0 16px;">+ Add note</button>
                            </div>
                            <div class="form-hint">Select a common medical note from the dropdown to add it to the notes.</div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn-vc">Save changes</button>
                        <a class="btn-vc-outline" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_PetFormScripts")
}
