@{
    Layout = "_DashboardLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Generate report</h3>
                <a class="vc-card-link" asp-action="Index">← Back to reports</a>
            </div>
            <div class="vc-card-body">
                <form asp-action="Generate" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label-vc">Report type *</label>
                            <select name="reportType" class="form-control-vc">
                                @foreach (var t in (string[])ViewBag.ReportTypes!)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-vc">From *</label>
                            <input name="from" type="date" class="form-control-vc" value="@ViewBag.From" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-vc">To *</label>
                            <input name="to" type="date" class="form-control-vc" value="@ViewBag.To" required />
                        </div>
                    </div>
                    <div class="vc-card-body p-0 mt-3">
                        <p class="page-note mb-0">
                            <span class="cell-strong">Clinical</span> — appointments, treatments, vet workload.
                            <span class="cell-strong">Financial</span> — billed, collected, receivables.
                            <span class="cell-strong">Operational</span> — inventory value, low stock, reminders.
                        </p>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn-vc">Generate</button>
                        <a class="btn-vc-outline" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
