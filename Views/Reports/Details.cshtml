@model VetCare.Models.Report
@{
    Layout = "_DashboardLayout";
    var isAdmin = User.GetUserRole() == "Administrator";
}

<div class="row justify-content-center">
    <div class="col-lg-11">
        <div class="vc-card">
            <div class="vc-card-head">
                <div>
                    <h3 class="vc-card-title">@Model.ReportType report</h3>
                    <div class="dash-title-sub">Generated by @Model.Generator?.Name · @Model.DateGenerated.ToString("MMMM dd, yyyy · h:mm tt")</div>
                </div>
                <span class="badge-vc @(Model.ReportType == "Clinical" ? "b-info" : Model.ReportType == "Financial" ? "b-paid" : "b-pending")">@Model.ReportType</span>
            </div>
            <div class="vc-card-body">
                <div class="d-flex gap-2 mb-4 flex-wrap">
                    <button type="button" class="btn-vc d-print-none" onclick="window.print()">🖨️ Print / Save as PDF</button>
                    <a class="btn-vc-outline d-print-none" asp-action="Index">← Back to reports</a>
                    <a class="btn-vc-outline d-print-none" asp-action="Generate">Generate another</a>
                    @if (isAdmin)
                    {
                        <form asp-action="Delete" method="post" class="d-print-none" data-confirm="Delete this report?">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.ReportID" />
                            <button class="btn-vc-outline btn-vc-danger" type="submit">Delete</button>
                        </form>
                    }
                </div>
                <div class="report-document">
                    @if (Model.Content.TrimStart().StartsWith("<"))
                    {
                        @Html.Raw(Model.Content)
                    }
                    else
                    {
                        <pre class="report-legacy">@Model.Content</pre>
                    }
                </div>
            </div>
        </div>
    </div>
</div>