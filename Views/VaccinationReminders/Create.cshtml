@{
    Layout = "_DashboardLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Set vaccination reminder</h3>
                <a class="vc-card-link" asp-action="Index">← Back to reminders</a>
            </div>
            <div class="vc-card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label-vc">Pet *</label>
                            <select name="petId" class="form-control-vc" asp-items="ViewBag.PetID" required>
                                <option value="">— Select pet —</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label-vc">Vaccine name *</label>
                            <input name="vaccineName" class="form-control-vc" required placeholder="e.g. Rabies (annual booster)" />
                        </div>
                        <div class="col-12">
                            <label class="form-label-vc">Due date *</label>
                            <input name="dueDate" type="date" class="form-control-vc" required />
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn-vc">Schedule reminder</button>
                        <a class="btn-vc-outline" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
