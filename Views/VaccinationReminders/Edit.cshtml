@model VetCare.Models.VaccinationReminder
@{
    Layout = "_DashboardLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Edit reminder</h3>
                <a class="vc-card-link" asp-action="Index">← Back to reminders</a>
            </div>
            <div class="vc-card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.ReminderID" />
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label-vc">Pet *</label>
                            <select name="petId" class="form-control-vc" asp-items="ViewBag.PetID" required></select>
                        </div>
                        <div class="col-12">
                            <label class="form-label-vc">Vaccine name *</label>
                            <input name="vaccineName" class="form-control-vc" value="@Model.VaccineName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-vc">Due date *</label>
                            <input name="dueDate" type="date" class="form-control-vc" value="@Model.DueDate.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-vc">Status</label>
                            <select name="status" class="form-control-vc">
                                @if (Model.Status == "Pending")
                                {
                                    <option value="Pending" selected>Pending</option>
                                    <option value="Sent">Sent</option>
                                }
                                else
                                {
                                    <option value="Pending">Pending</option>
                                    <option value="Sent" selected>Sent</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn-vc">Save changes</button>
                        <a class="btn-vc-outline" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
