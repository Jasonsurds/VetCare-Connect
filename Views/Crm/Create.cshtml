@{
    Layout = "_DashboardLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Log CRM interaction</h3>
                <a class="vc-card-link" asp-action="Index">← Back to CRM</a>
            </div>
            <div class="vc-card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label-vc">Pet owner *</label>
                            <select name="ownerId" class="form-control-vc" asp-items="ViewBag.OwnerID" required>
                                <option value="">— Select owner —</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label-vc">Interaction note</label>
                            <textarea name="interaction" class="form-control-vc" placeholder="e.g. Follow-up call after surgery; owner reports full recovery."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label-vc">Customer feedback</label>
                            <textarea name="feedback" class="form-control-vc" placeholder="What did the customer say about the service?"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label-vc">Bonus loyalty points</label>
                            <input name="loyaltyPoints" type="number" min="0" value="0" class="form-control-vc" />
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn-vc">Save interaction</button>
                        <a class="btn-vc-outline" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
