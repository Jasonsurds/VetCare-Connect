@model VetCare.Models.InventoryItem
@{
    Layout = "_DashboardLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="vc-card">
            <div class="vc-card-head">
                <h3 class="vc-card-title">Add inventory item</h3>
                <a class="vc-card-link" asp-action="Index">← Back to inventory</a>
            </div>
            <div class="vc-card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label-vc" asp-for="ItemName">Item name *</label>
                            <input asp-for="ItemName" class="form-control-vc" placeholder="e.g. Rabies Vaccine" />
                            <span asp-validation-for="ItemName" class="field-validation-error"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-vc" asp-for="Category">Category *</label>
                            <select asp-for="Category" class="form-control-vc">
                                <option value="Vaccine">Vaccine</option>
                                <option value="Antibiotic">Antibiotic</option>
                                <option value="Dewormer">Dewormer</option>
                                <option value="Antiparasitic">Antiparasitic</option>
                                <option value="Supplement">Supplement</option>
                                <option value="Supplies">Supplies</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-vc" asp-for="Quantity">Quantity *</label>
                            <input asp-for="Quantity" type="number" min="0" class="form-control-vc" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-vc" asp-for="UnitPrice">Unit price (₱) *</label>
                            <input asp-for="UnitPrice" type="number" step="0.01" min="0" class="form-control-vc" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-vc" asp-for="ReorderLevel">Reorder level *</label>
                            <input asp-for="ReorderLevel" type="number" min="0" class="form-control-vc" />
                            <div class="form-hint">Alert triggers when stock falls to or below this number.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-vc" asp-for="SupplierID">Supplier</label>
                            <select asp-for="SupplierID" class="form-control-vc" asp-items="ViewBag.SupplierID">
                                <option value="">— None —</option>
                            </select>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn-vc">Add item</button>
                        <a class="btn-vc-outline" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
